{
  "providers": {
    "openai": {
      "type": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "env:OPENAI_API_KEY",
      "timeoutMs": 15000
    }
  },
  "models": {
    "fast_chat": {
      "provider": "openai",
      "model": "gpt-4o-mini",
      "temperature": 0.2,
      "maxTokens": 600,
      "kind": "chat"
    },
    "deep_chat": {
      "provider": "openai",
      "model": "gpt-4.1-mini",
      "temperature": 0.1,
      "maxTokens": 900,
      "kind": "chat"
    },
    "embed_small": {
      "provider": "openai",
      "model": "text-embedding-3-small",
      "kind": "embedding"
    }
  },
  "memory": {
    "maxEntitiesPerPatch": 600,
    "maxRelationsPerPatch": 1200,
    "maxEpisodesPerPatch": 1600
  }
}
